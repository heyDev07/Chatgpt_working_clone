# Provider plugin cache - large, regenerated by `terraform init`, never committed.
.terraform/

# State holds real resource IDs and, since several variables here are marked sensitive, their
# values too - never belongs in git regardless of whether a remote backend is configured later.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real variable values (db_password, jwt_secret_key, api keys) belong in a local .tfvars file or
# TF_VAR_* environment variables, never committed - .tfvars.example below is the only exception,
# and it must never contain a real secret.
*.tfvars
!*.tfvars.example

crash.log
crash.*.log
